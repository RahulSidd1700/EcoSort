{
  "name": "ecosort",
  "private": true,
  "version": "1.0.0",
  "description": "EcoSort - AI-Enabled Smart Waste Segregation, Recycling and Collection Management System",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
