# Firebase Web App config (Firebase Console > Project settings > Your apps > Web app)
# These values identify your project; they are NOT secrets. Security comes from
# Firebase Auth + Firestore/Storage rules. NEVER put AI API keys here.
VITE_FIREBASE_API_KEY=your-web-api-key
VITE_FIREBASE_AUTH_DOMAIN=your-project-id.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your-project-id
VITE_FIREBASE_MESSAGING_SENDER_ID=000000000000
VITE_FIREBASE_APP_ID=1:000000000000:web:0000000000000000

# Cloud Functions region (must match REGION in functions/src/constants.js)
VITE_FUNCTIONS_REGION=asia-south1

# Set to "true" to connect to the local Firebase Emulator Suite
VITE_USE_EMULATORS=false
